DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DATABASE_URL=postgresql://user:password@host:5432/kofad
DJANGO_ALLOWED_HOSTS=your-service.up.railway.app
CSRF_TRUSTED_ORIGINS=https://your-service.up.railway.app
DJANGO_DEBUG=0
SECURE_SSL_REDIRECT=1

# SMS: enable only after provider setup; sandbox is the default.
SMS_ENABLED=0
SMS_PROVIDER=arkesel
SMS_SENDER_ID=KOFAD
SMS_SANDBOX=1
SMS_PUBLIC_ORIGIN=https://your-service.up.railway.app
ARKESEL_API_KEY=
# One-time setup only: set KOFAD_INITIAL_ADMIN_PASSWORD privately for bootstrap_admin,
# then remove it. Never keep a bootstrap password as a permanent deployment variable.

# First live setup: generate privately; protects the temporary admin password.

# KOFAD Market: customer verification, online payments and product-image handling.
CUSTOMER_OTP_ENABLED=0
PAYSTACK_SECRET_KEY=
PAYSTACK_TIMEOUT_SECONDS=20
MARKET_IMAGE_MAX_BYTES=26214400
MARKET_RESERVATION_MINUTES=20

# Hubtel Sales credentials; never commit real values.
HUBTEL_API_ID=
HUBTEL_API_KEY=
HUBTEL_COLLECTION_ACCOUNT=
# Keep disabled until Hubtel integration testing/UAT authorizes launch.
HUBTEL_CHECKOUT_ENABLED=0
HUBTEL_TIMEOUT_SECONDS=10
