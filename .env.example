DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DATABASE_URL=postgresql://user:password@host:5432/kofad
DJANGO_ALLOWED_HOSTS=your-service.up.railway.app
CSRF_TRUSTED_ORIGINS=https://your-service.up.railway.app
DJANGO_DEBUG=0
SECURE_SSL_REDIRECT=1

# SMS: enable only after provider setup; sandbox is the default.
SMS_ENABLED=0
SMS_PROVIDER=arkesel
SMS_SENDER_ID=KOFAD
SMS_SANDBOX=1
SMS_PUBLIC_ORIGIN=https://your-service.up.railway.app
ARKESEL_API_KEY=
# One-time setup only: set KOFAD_INITIAL_ADMIN_PASSWORD privately for bootstrap_admin,
# then remove it. Never keep a bootstrap password as a permanent deployment variable.

# First live setup: generate privately; protects the temporary admin password.

# KOFAD Market: customer verification, online payments and product-image handling.
CUSTOMER_OTP_ENABLED=0
PAYSTACK_SECRET_KEY=
PAYSTACK_TIMEOUT_SECONDS=20
MARKET_IMAGE_MAX_BYTES=26214400
MARKET_RESERVATION_MINUTES=20

# Hubtel Sales credentials; never commit real values.
HUBTEL_API_ID=
HUBTEL_API_KEY=
HUBTEL_COLLECTION_ACCOUNT=
# Keep disabled until Hubtel integration testing/UAT authorizes launch.
HUBTEL_CHECKOUT_ENABLED=0
HUBTEL_TIMEOUT_SECONDS=10

# KOFAD Official Telegram - API token must be configured privately in Railway.
TELEGRAM_BOT_ENABLED=0
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_BASE_URL=https://staff.kofadimpex.com

# Independently controlled enterprise Telegram rollout switches (start disabled).
TELEGRAM_ACCOUNT_LINK_ENABLED=0
TELEGRAM_BUSINESS_ANALYTICS_ENABLED=0
TELEGRAM_NOTIFICATIONS_ENABLED=0
TELEGRAM_RECOVERY_ENABLED=0

# Extra specialized bots (credentials belong in Railway Variables, never GitHub).
TELEGRAM_CUSTOMER_BOT_USERNAME=
TELEGRAM_STAFF_BOT_USERNAME=
TELEGRAM_CUSTOMER_BOT_TOKEN=
TELEGRAM_STAFF_BOT_TOKEN=
TELEGRAM_CUSTOMER_WEBHOOK_SECRET=
TELEGRAM_STAFF_WEBHOOK_SECRET=
TELEGRAM_CUSTOMER_BOT_ENABLED=0
TELEGRAM_STAFF_BOT_ENABLED=0


# KOFAD public company / customer assistant - strictly $0 OpenRouter free routing.
# Create your key at openrouter.ai and add it only in Railway web variables.
# No key => public catalogue/FAQ/local answers still work.
# This deployment never chooses a paid model, even when free quota is exhausted.
# Free models have rate limits and third-party retention/training policies.
# The website asks for explicit consent before sharing PUBLIC questions.
OPENROUTER_API_KEY=
KOFAD_OPENROUTER_FREE_ENABLED=0

# Hubtel Direct (requires verified static outbound IP + Hubtel scope before enabling)
HUBTEL_DISBURSEMENT_ACCOUNT=
HUBTEL_DIRECT_EGRESS_CONFIRMED=0
HUBTEL_DIRECT_RECONCILE_TOKEN=
HUBTEL_DIRECT_RECEIVE_ENABLED=0
HUBTEL_DIRECT_SEND_MOMO_ENABLED=0
HUBTEL_DIRECT_SEND_BANK_ENABLED=0
HUBTEL_DIRECT_MAX_PAYOUT_GHS=500.00
